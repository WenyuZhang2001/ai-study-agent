<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.wenyuzhang.ai-study-agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-i</string>
		<string>-s</string>
		<string>/Users/AGENT_USER/ai-study-agent/.venv/bin/python</string>
		<string>-u</string>
		<string>/Users/AGENT_USER/ai-study-agent/server.py</string>
		<string>--always-on</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/AGENT_USER/ai-study-agent</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ExitTimeOut</key>
	<integer>30</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>AbandonProcessGroup</key>
	<false/>
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardOutPath</key>
	<string>/Users/AGENT_USER/ai-study-agent/logs/launchd.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/AGENT_USER/ai-study-agent/logs/launchd.stderr.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/AGENT_USER</string>
		<key>PATH</key>
		<string>/Users/AGENT_USER/ai-study-agent/.venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>SSL_CERT_FILE</key>
		<string>/Users/AGENT_USER/ai-study-agent/.venv/lib/python3.12/site-packages/certifi/cacert.pem</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
</dict>
</plist>
